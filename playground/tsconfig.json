{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@turingfocus/chat-gateway-tfrobot": [
        "../packages/chat-gateway-tfrobot/src/index.ts"
      ],
      "@turingfocus/chat-auth/headless": [
        "../packages/chat-auth/src/headless.ts"
      ],
      "@turingfocus/chat-auth/react": ["../packages/chat-auth/src/react.ts"],
      "@turingfocus/chat-auth/antd": ["../packages/chat-auth/src/antd.ts"],
      "@turingfocus/chat-kit": ["../packages/chat-kit/src/index.ts"],
      "@turingfocus/chat-protocol": ["../packages/chat-protocol/src/index.ts"],
      "@turingfocus/chat-react": ["../packages/chat-react/src/index.ts"],
      "@turingfocus/chat-runtime": ["../packages/chat-runtime/src/index.ts"],
      "@turingfocus/chat-testing": ["../packages/chat-testing/src/index.ts"],
      "@turingfocus/chat-ui-antd": ["../packages/chat-ui-antd/src/index.ts"]
    },
    "rootDir": "..",
    "sourceMap": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
