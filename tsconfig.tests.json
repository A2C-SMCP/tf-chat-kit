{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@turingfocus/chat-auth/headless": [
        "./packages/chat-auth/src/headless.ts"
      ],
      "@turingfocus/chat-auth/tfrobot": ["./packages/chat-auth/src/tfrobot.ts"],
      "@turingfocus/chat-auth/react": ["./packages/chat-auth/src/react.ts"],
      "@turingfocus/chat-auth/antd": ["./packages/chat-auth/src/antd.ts"],
      "@turingfocus/chat-gateway-tfrobot": [
        "./packages/chat-gateway-tfrobot/src/index.ts"
      ],
      "@turingfocus/chat-kit": ["./packages/chat-kit/src/index.ts"],
      "@turingfocus/chat-kit/headless": ["./packages/chat-kit/src/headless.ts"],
      "@turingfocus/chat-kit/antd": ["./packages/chat-kit/src/antd.ts"],
      "@turingfocus/chat-protocol": ["./packages/chat-protocol/src/index.ts"],
      "@turingfocus/chat-react": ["./packages/chat-react/src/index.ts"],
      "@turingfocus/chat-runtime": ["./packages/chat-runtime/src/index.ts"],
      "@turingfocus/chat-testing": ["./packages/chat-testing/src/index.ts"],
      "@turingfocus/chat-ui-antd": ["./packages/chat-ui-antd/src/index.ts"],
      "@turingfocus/chat-auth/manager": ["./packages/chat-auth/src/manager.ts"],
      "@turingfocus/chat-kit/manager": ["./packages/chat-kit/src/manager.ts"],
      "@turingfocus/chat-kit/manager-react": [
        "./packages/chat-kit/src/manager-react.ts"
      ]
    },
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "playwright.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
